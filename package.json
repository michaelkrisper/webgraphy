{
	"name": "webgraphy",
	"private": true,
	"version": "1.2.0",
	"author": "Michael Krisper",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"bench": "vitest bench --run --outputJson=bench-result.json",
		"bench:check": "npm run bench && node scripts/bench-check.mjs",
		"bench:update": "npm run bench && node scripts/bench-check.mjs --update",
		"size:check": "npm run build && node scripts/size-check.mjs",
		"size:update": "npm run build && node scripts/size-check.mjs --update",
		"analyze": "ANALYZE=1 npm run build",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@fontsource/comic-neue": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/source-serif-4": "^5.3.0",
		"idb": "^8.0.3",
		"lucide-react": "^1.33.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"workbox-window": "^7.4.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.11",
		"axe-core": "^4.13.0",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.5",
		"vitest-axe": "^0.1.0"
	},
	"overrides": {
		"serialize-javascript": "^7.0.5",
		"fast-uri": "^3.1.2",
		"@babel/plugin-transform-modules-systemjs": "^7.29.4"
	}
}
